{
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start-dist": "node dist/index.js",
    "dev": "nodemon --watch src --exec tsx src/index.ts",
    "render": "tsx src/index.ts && openscad dist/output.scad -o dist/output.stl",
    "test": "npm run build && mocha",
    "build": "tsc && tsx src/copyPresets.ts",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"**/*.{js,ts}\""
  },
  "dependencies": {
    "adm-zip": "^0.5.9",
    "body-parser": "^1.20.0",
    "express": "^4.18.1",
    "node-stl": "^0.7.2",
    "nodemon": "^2.0.7",
    "scad-js": "^0.5.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "chai": "^4.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.4.0",
    "npm": "^8.9.0",
    "prettier": "^3.1.1",
    "typescript": "^5.8.3"
  },
  "name": "scad-models",
  "version": "1.0.0",
  "main": "dist/index.js",
  "repository": "https://github.com/popstas/scad-models",
  "license": "MIT"
}
